<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
    <top>
        <VBox alignment="CENTER" style="-fx-background-color: #2c3e50;">
            <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></padding>
            <Label text="CinemaUQ - Sistema de Gestión de Cine" textFill="WHITE">
                <font><Font name="System Bold" size="22.0" /></font>
            </Label>
            <Label fx:id="lblEstadoSesion" text="Por favor, inicie sesión para continuar" textFill="#bdc3c7" />
        </VBox>
    </top>
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">

            <!-- 1. LOGIN -->
            <Tab fx:id="tabLogin" text="1. Iniciar Sesión">
                <VBox alignment="CENTER" spacing="15.0">
                    <Label text="Acceso de Clientes - CinemaUQ">
                        <font><Font name="System Bold" size="18.0" /></font>
                    </Label>
                    <TextField fx:id="txtEmail" maxWidth="300.0" promptText="Correo Electrónico" text="cliente@uq.edu.co" />
                    <PasswordField fx:id="txtPassword" maxWidth="300.0" promptText="Contraseña" text="1234" />
                    <Button mnemonicParsing="false" onAction="#onLoginClick" prefWidth="150.0" text="Ingresar" style="-fx-background-color: #3498db; -fx-text-fill: white;" />
                    <Label fx:id="lblLoginError" textFill="#e74c3c" />
                </VBox>
            </Tab>

            <!-- 2. CARTELERA Y FUNCIONES -->
            <Tab fx:id="tabCartelera" text="2. Cartelera" disable="true">
                <VBox spacing="15.0">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></padding>
                    <Label text="Funciones Disponibles en Cartelera:">
                        <font><Font name="System Bold" size="16.0" /></font>
                    </Label>
                    <ListView fx:id="listaFunciones" prefHeight="250.0" />
                    <Button text="Seleccionar Asientos para esta Función" onAction="#onIrAAsientosClick" style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
                    <Label fx:id="lblCarteleraMsg" textFill="#c0392b" />
                </VBox>
            </Tab>

            <!-- 3. SELECCIÓN GRÁFICA DE ASIENTOS -->
            <Tab fx:id="tabAsientos" text="3. Selección de Asientos" disable="true">
                <VBox alignment="CENTER" spacing="15.0">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></padding>
                    <Label text="--- PANTALLA DE CINE ---">
                        <font><Font name="System Bold" size="14.0" /></font>
                    </Label>
                    <Separator maxWidth="400.0" />
                    <!-- Matriz de botones generada dinámicamente -->
                    <GridPane fx:id="gridAsientos" alignment="CENTER" hgap="10.0" vgap="10.0" />
                    <HBox alignment="CENTER" spacing="20.0">
                        <Label text="🟩 Disponible" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;" />
                        <Label text="🟨 Seleccionado" style="-fx-text-fill: #d35400; -fx-font-weight: bold;" />
                        <Label text="🟥 Ocupado" style="-fx-text-fill: #c0392b; -fx-font-weight: bold;" />
                    </HBox>
                    <Button text="Confirmar Asientos e Ir a Confitería" onAction="#onConfirmarAsientosClick" style="-fx-background-color: #2980b9; -fx-text-fill: white;" />
                    <Label fx:id="lblAsientosMsg" textFill="#c0392b" />
                </VBox>
            </Tab>

            <!-- 4. CONFITERÍA -->
            <Tab fx:id="tabConfiteria" text="4. Confitería" disable="true">
                <VBox spacing="15.0">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></padding>
                    <Label text="Catálogo de Confitería y Combos:">
                        <font><Font name="System Bold" size="16.0" /></font>
                    </Label>
                    <ListView fx:id="listaProductos" prefHeight="200.0" />
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Label text="Cantidad:" />
                        <TextField fx:id="txtCantidadProducto" text="1" prefWidth="80.0" />
                        <Button text="Añadir al Carrito" onAction="#onAgregarProductoClick" style="-fx-background-color: #8e44ad; -fx-text-fill: white;" />
                    </HBox>
                    <Label fx:id="lblConfiteriaResumen" text="Productos en el carrito: 0" style="-fx-font-weight: bold;" />
                    <Button text="Proceder al Resumen y Pago" onAction="#onIrAPagoClick" style="-fx-background-color: #e67e22; -fx-text-fill: white;" />
                </VBox>
            </Tab>

            <!-- 5. RESUMEN Y PAGO -->
            <Tab fx:id="tabPago" text="5. Resumen y Pago" disable="true">
                <VBox alignment="CENTER" spacing="15.0">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>
                    <Label text="Resumen de su Compra">
                        <font><Font name="System Bold" size="18.0" /></font>
                    </Label>
                    <TextArea fx:id="txtAreaResumen" editable="false" maxHeight="180.0" maxWidth="550.0" />
                    <HBox alignment="CENTER" spacing="15.0">
                        <Label text="Total a Pagar: $" />
                        <Label fx:id="lblTotalPagar" text="0.0" textFill="#c0392b">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                    </HBox>
                    <HBox alignment="CENTER" spacing="15.0">
                        <Label text="Saldo Tarjeta Virtual: $" />
                        <Label fx:id="lblSaldoTarjeta" text="0.0" textFill="#27ae60">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                    </HBox>
                    <Button text="Confirmar Compra (Pagar con Tarjeta)" onAction="#onPagarCompraClick" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px;" />
                    <Label fx:id="lblResultadoPago" textFill="#27ae60">
                        <font><Font name="System Bold" size="14.0" /></font>
                    </Label>
                    <Button text="Volver al Inicio (Verificar Asientos Ocupados)" onAction="#onReiniciarFlujoClick" />
                </VBox>
            </Tab>

            <!-- 6. TARJETA Y PUNTOS -->
            <Tab fx:id="tabTarjeta" text="Mi Tarjeta" disable="true">
                <VBox alignment="CENTER" spacing="15.0">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>
                    <Label text="Gestión de Saldo y Puntos Lealtad">
                        <font><Font size="18.0" /></font>
                    </Label>
                    <HBox alignment="CENTER" spacing="10.0">
                        <TextField fx:id="txtMontoRecarga" promptText="Monto a recargar" />
                        <Button text="Recargar Saldo" onAction="#onRecargarClick" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" />
                    </HBox>
                    <Label fx:id="lblRecargaStatus" textFill="#27ae60" />
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>